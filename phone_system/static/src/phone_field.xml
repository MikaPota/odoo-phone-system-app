<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="phone_system.PhoneField" t-inherit="web.PhoneField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_phone_content')]" position="inside">
            <t t-call="phone_system.DialButton"/>
        </xpath>
    </t>
    <!-- Form views use their own copy of the phone template, which does not take extensions of web.PhoneField. -->
    <t t-name="phone_system.FormPhoneField" t-inherit="web.FormPhoneField" t-inherit-mode="extension">
        <xpath expr="//input" position="after">
            <t t-call="phone_system.DialButton"/>
        </xpath>
    </t>
    <t t-name="phone_system.CharField" t-inherit="web.CharField" t-inherit-mode="extension">
        <xpath expr="//span" position="after">
            <t t-call="phone_system.DialButton"/>
        </xpath>
        <xpath expr="//input" position="after">
            <t t-call="phone_system.DialButton"/>
        </xpath>
    </t>
    <t t-name="phone_system.DialButton">
        <button t-if="vodiaCanDial" type="button" class="btn btn-link p-0 ms-2 o_vodia_dial"
                title="Call with the phone system" aria-label="Call with the phone system" t-on-click.stop.prevent="vodiaDial">
            <i class="fa fa-phone" aria-hidden="true"/>
        </button>
    </t>
</templates>
