<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_pilot" model="res.groups">
        <field name="name">Phone System User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_pilot_call_owner" model="ir.rule">
        <field name="name">Phone System calls: own history</field>
        <field name="model_id" ref="model_vodia_pilot_call"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_pilot'))]"/>
    </record>
    <record id="rule_pilot_call_admin" model="ir.rule">
        <field name="name">Phone System calls: administrators</field>
        <field name="model_id" ref="model_vodia_pilot_call"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <record id="rule_network_invitation_sender" model="ir.rule">
        <field name="name">GCNA network invitations: own</field>
        <field name="model_id" ref="model_vodia_network_invitation"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_pilot'))]"/>
    </record>
    <record id="rule_network_invitation_admin" model="ir.rule">
        <field name="name">GCNA network invitations: administrators</field>
        <field name="model_id" ref="model_vodia_network_invitation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
