<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Opened by the "Calls" button Phone System adds to employee cards when the Employees app is installed. -->
    <record id="action_employee_calls" model="ir.actions.server">
        <field name="name">Calls</field>
        <field name="model_id" ref="model_vodia_pilot_call"/>
        <field name="state">code</field>
        <field name="code">action = model._employee_calls_action(env.context.get("active_id"))</field>
    </record>
</odoo>
