<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_vodia_calls" model="ir.ui.view">
        <field name="name">hr.employee.form.vodia.calls</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_vodia_calls" type="object" class="oe_stat_button" icon="fa-phone"
                        groups="phone_system.group_pilot,base.group_system">
                    <field name="vodia_call_count" widget="statinfo" string="Calls"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
